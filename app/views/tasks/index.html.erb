<% content_for :title, "Tasks" %>

<% if notice %>
  <p id="notice"><%= notice %></p>
<% end %>

<h1>RoR - tryellmo.ai Demo app</h1>
<p>A small task list, backed by SQLite, to prove the Rails app is fully wired up end to end.</p>

<% if @tasks.any? %>
  <table id="tasks">
    <thead>
      <tr>
        <th>Title</th>
        <th>Description</th>
        <th>Completed</th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr id="<%= dom_id task %>">
          <td><%= task.title %></td>
          <td><%= task.description %></td>
          <td><%= task.completed? ? "Yes" : "No" %></td>
          <td><%= link_to "Show", task %></td>
          <td><%= link_to "Edit", edit_task_path(task) %></td>
          <td><%= link_to "Delete", task, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">No tasks yet — create the first one below.</p>
<% end %>

<p>
  <%= link_to "New task", new_task_path, class: "button button--brand" %>
</p>
